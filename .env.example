# انسخه إلى .env (تطوير) — وفي الإنتاج اضبط القيم في لوحة الاستضافة.
# .env لا يدخل المستودع أبدًا. في الإنتاج (NODE_ENV=production) يرفض الخادم
# الإقلاع إن نقص منها ما هو مطلوب — انظر src/config/env.ts.

NODE_ENV=development
# ٣٠٩٩ لا ٣٠٠٠ ولا ٣٠٠١ في التطوير: الاثنان مأخوذان عادةً بخوادم Next.
# في الإنتاج تضبطه الاستضافة غالبًا (الصورة تستمع على 3000).
PORT=3099

# ── قاعدة البيانات (مطلوب) ─────────────────────────────────
# 127.0.0.1 لا localhost: على ويندوز يُحلّ الأخير إلى ::1 أحيانًا فيفشل الاتصال.
# الإنتاج: PostgreSQL مُدار (Neon / Supabase / RDS …) مع ?sslmode=require غالبًا.
DATABASE_URL="postgresql://azm:azm_dev_only@127.0.0.1:5433/azm?schema=public"

# ── الجلسات (مطلوب) ────────────────────────────────────────
# ولّد سرًّا حقيقيًا للإنتاج (٣٢ حرفًا على الأقل):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── العنوان العام والواجهات (مطلوب في الإنتاج) ─────────────
# العنوان الذي يصل منه العالم إلى هذا الخادم — بلا /api/v1.
PUBLIC_API_URL="http://localhost:3099"
# أصول الواجهات المسموح لها، مفصولة بفواصل. `https://*.domain` يطابق النطاقات الفرعية.
# واجهة المتجر العامة (/shop/storefront/*) مفتوحة لكل الأصول لأجل النطاقات الخاصة للتجّار.
# الإنتاج مثلًا:
#   CORS_ORIGINS="https://azm.rvios.com,https://store.rvios.com,https://rvios.store,https://*.rvios.store,https://www.rvios.com,https://rvios.com"
# ‏3001 = AzmSmart-OS · 3020 = منصة المتاجر · 3000 = الموقع الرئيسي
CORS_ORIGINS="http://localhost:3001,http://localhost:3020,http://localhost:3000"
# عدد القفزات الموثوقة أمام الخادم (موازن حمل / CDN) — لقراءة عنوان الزائر الحقيقي
# في حدود الطلبات. الافتراضي 1 في الإنتاج و0 في التطوير.
# TRUST_PROXY=1

# ملح ثابت لعدّ زيارات المتاجر دون تخزين عناوين الزوّار (مطلوب في الإنتاج).
VISIT_SALT="dev-visit-salt"

# ── تخزين الصور: Cloudflare R2 (مطلوب في الإنتاج) ───────────
# حين تكتمل الخمسة تُرفع الصور إلى الحاوية (مجلد لكل متجر: stores/<storeId>/)،
# وإلا فإلى القرص المحلي (UPLOAD_DIR). STORAGE_DRIVER=local|r2 يفرض أحدهما،
# والاختبارات (NODE_ENV=test) على القرص دائمًا. القيم الحقيقية في .env وحده.
CF_ACCOUNT_ID=""
CF_ACCESS_KEY_ID=""
CF_SECRET_ACCESS_KEY=""
CF_BUCKET_NAME=""
CF_PUBLIC_URL=""
# STORAGE_DRIVER=r2
# UPLOAD_DIR=./uploads
# STORAGE_GC=0          # يعطّل تنظيف صور المتاجر غير المستعملة

# ── إشعارات التجّار عبر واتساب (اختياري) ────────────────────
# console | whatsapp | whatsapp,console — انظر docs/SETUP-META.md
NOTIFY_CHANNELS=console
META_TOKEN=""
WA_PHONE_ID=""
META_APP_SECRET=""
WA_API_VERSION=v21.0

# ── العمّال الدوريّون ───────────────────────────────────────
# على أكثر من نسخة من الخادم: أبقِهما في نسخة واحدة واضبطهما 0 في البقية.
# BILLING_WORKER=0      # تذكيرات الاشتراكات وانتهاؤها
# WEBHOOK_WORKER=0      # إرسال خطافات المطوّرين

# ── حدود الطلبات العامة (اختياري) ──────────────────────────
# CONTACT_LIMIT=5       # رسائل التواصل في الساعة لكل عنوان
# SHOP_ORDER_LIMIT=10   # طلبات المتجر كل ١٠ دقائق لكل عنوان ومتجر

# للتطوير والاختبارات فقط — يرفضه الإنتاج:
# WEBHOOK_ALLOW_PRIVATE=1
