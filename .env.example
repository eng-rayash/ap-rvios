# انسخه إلى .env (تطوير) — وفي الإنتاج اضبط القيم في لوحة الاستضافة.
# .env لا يدخل المستودع أبدًا. في الإنتاج (NODE_ENV=production) يرفض الخادم
# الإقلاع إن نقص منها ما هو مطلوب — انظر src/config/env.ts.

NODE_ENV=development
# ٣٠٩٩ لا ٣٠٠٠ ولا ٣٠٠١ في التطوير: الاثنان مأخوذان عادةً بخوادم Next.
# في الإنتاج تضبطه الاستضافة غالبًا (الصورة تستمع على 3000).
PORT=3099

# ── قاعدة البيانات (مطلوب) ─────────────────────────────────
# 127.0.0.1 لا localhost: على ويندوز يُحلّ الأخير إلى ::1 أحيانًا فيفشل الاتصال.
# الإنتاج: PostgreSQL مُدار (Neon / Supabase / RDS …) مع ?sslmode=require غالبًا.
DATABASE_URL="postgresql://azm:azm_dev_only@127.0.0.1:5433/azm?schema=public"

# ── الجلسات (مطلوب) ────────────────────────────────────────
# ولّد سرًّا حقيقيًا للإنتاج (٣٢ حرفًا على الأقل):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ── العنوان العام والواجهات (مطلوب في الإنتاج) ─────────────
# العنوان الذي يصل منه العالم إلى هذا الخادم — بلا /api/v1.
PUBLIC_API_URL="http://localhost:3099"
# أصول الواجهات المسموح لها، مفصولة بفواصل. `https://*.domain` يطابق النطاقات الفرعية.
# واجهة المتجر العامة (/shop/storefront/*) مفتوحة لكل الأصول لأجل النطاقات الخاصة للتجّار.
# الإنتاج مثلًا:
#   CORS_ORIGINS="https://azm.rvios.com,https://store.rvios.com,https://rvios.store,https://*.rvios.store,https://www.rvios.com,https://rvios.com"
# ‏3001 = AzmSmart-OS · 3020 = منصة المتاجر · 3000 = الموقع الرئيسي
CORS_ORIGINS="http://localhost:3001,http://localhost:3020,http://localhost:3000"
# عدد القفزات الموثوقة أمام الخادم (موازن حمل / CDN) — لقراءة عنوان الزائر الحقيقي
# في حدود الطلبات. الافتراضي 1 في الإنتاج و0 في التطوير.
# TRUST_PROXY=1

# ملح ثابت لعدّ زيارات المتاجر دون تخزين عناوين الزوّار (مطلوب في الإنتاج).
VISIT_SALT="dev-visit-salt"

# ── تخزين الصور: Cloudflare R2 (مطلوب في الإنتاج) ───────────
# حين تكتمل الخمسة تُرفع الصور إلى الحاوية (مجلد لكل متجر: stores/<storeId>/)،
# وإلا فإلى القرص المحلي (UPLOAD_DIR). STORAGE_DRIVER=local|r2 يفرض أحدهما،
# والاختبارات (NODE_ENV=test) على القرص دائمًا. القيم الحقيقية في .env وحده.
CF_ACCOUNT_ID=""
CF_ACCESS_KEY_ID=""
CF_SECRET_ACCESS_KEY=""
CF_BUCKET_NAME=""
CF_PUBLIC_URL=""
# STORAGE_DRIVER=r2
# UPLOAD_DIR=./uploads
# STORAGE_GC=0          # يعطّل تنظيف صور المتاجر غير المستعملة

# ── إشعارات التجّار عبر واتساب (اختياري) ────────────────────
# console | whatsapp | whatsapp,console — انظر docs/SETUP-META.md
NOTIFY_CHANNELS=console
META_TOKEN=""
WA_PHONE_ID=""
META_APP_SECRET=""
WA_API_VERSION=v21.0

# ── العمّال الدوريّون ───────────────────────────────────────
# على أكثر من نسخة من الخادم: أبقِهما في نسخة واحدة واضبطهما 0 في البقية.
# BILLING_WORKER=0      # تذكيرات الاشتراكات وانتهاؤها
# WEBHOOK_WORKER=0      # إرسال خطافات المطوّرين

# ── حدود الطلبات العامة (اختياري) ──────────────────────────
# CONTACT_LIMIT=5       # رسائل التواصل في الساعة لكل عنوان
# SHOP_ORDER_LIMIT=10   # طلبات المتجر كل ١٠ دقائق لكل عنوان ومتجر
# AUTH_LOGIN_ACCOUNT_LIMIT=10  # إخفاقات الدخول لكل حساب كل ١٥ دقيقة
# AUTH_LOGIN_IP_LIMIT=30       # إخفاقات الدخول لكل عنوان كل ١٥ دقيقة
# AUTH_REGISTER_LIMIT=10       # حسابات جديدة لكل عنوان في الساعة

# للتطوير والاختبارات فقط — يرفضه الإنتاج:
# WEBHOOK_ALLOW_PRIVATE=1

# البريد الصادر (Resend). المرسل من نطاق موثَّق في Resend — gmail.com لا يُقبل مرسلًا.
RESEND_API_KEY=""
EMAIL_FROM="RVIOS <no-reply@rvios.com>"
EMAIL_REPLY_TO="rviostech@gmail.com"
# 1 = رمز بالبريد عند التسجيل والدخول. لا يُفعَّل قبل توثيق النطاق: من لا يصله الرمز لا يدخل.
EMAIL_OTP_ENABLED="0"
# بعد تأكيد رمز البريد يُعفى الجهاز من الرمز هذه المدة (أيام، 0 يعطّل)
AUTH_TRUSTED_DEVICE_DAYS="30"

# تجديد صفحات المتاجر في منصة المتاجر بعد التعليق والتفعيل والتعديل (نفس السرّ هناك)
STOREFRONT_URL=""
REVALIDATE_SECRET=""

# ── RVIOS AI (مساعد التاجر) — Google Gemini عبر SDK الرسمي، من الخادم وحده ──
# المفتاح من https://aistudio.google.com/apikey — لا يُكتب في الشيفرة ولا يُرفع إلى Git.
# بدونه تظهر الميزة «غير مفعّلة» ولا يتعطل شيء آخر.
GEMINI_API_KEY=""
# سلسلة نماذج: يُجرَّب الأول، والتالي فقط حين يرفض المزوّد أو يعلّق قبل أول كلمة
# (رفض لا يُحتسب تكلفةً). للجودة الأعلى: gemini-flash-latest,gemini-flash-lite-latest
GEMINI_MODELS="gemini-flash-lite-latest,gemini-flash-latest"
GEMINI_LITE_MODELS="gemini-flash-lite-latest"
# التفكير الداخلي يأكل رموزًا مدفوعة ويؤخّر الرد: LOW | MEDIUM | HIGH | OFF
GEMINI_THINKING_LEVEL="LOW"
# طلبات شهرية لكل متجر حسب الباقة (basic=المجانية، plus=الاحترافية، pro=الأعمال) — 0 يعطّلها
AI_LIMIT_BASIC="30"
AI_LIMIT_PLUS="400"
AI_LIMIT_PRO="2000"
# حدّ لكل مستخدم في الدقيقة، ومهلة الطلب، ومهلة أول كلمة قبل الانتقال إلى النموذج التالي (ملّي ثانية)
AI_PER_MINUTE="12"
AI_TIMEOUT_MS="90000"
AI_FIRST_TOKEN_MS="20000"
AI_MAX_OUTPUT_TOKENS="2048"
# مساعد الزوّار على www.rvios.com وstore.rvios.com: أسئلة يوميًا للمنصة كلها (0 يطفئه)، ولكل زائر، وبالدقيقة
AI_PUBLIC_DAILY="1500"
AI_PUBLIC_PER_IP_DAY="40"
AI_PUBLIC_PER_MINUTE="6"
# الأصول المسموح لها باستعمال مساعد الزوّار (افتراضيًا نطاقات RVIOS ومنافذ التطوير المحلية)
# AI_PUBLIC_ORIGINS="https://www.rvios.com,https://rvios.com,https://store.rvios.com,https://rvios.store"

# ── إشعارات الدفع (Firebase Cloud Messaging) — تطبيق عزم وتطبيق RVOS ──
# من Firebase Console → Project settings → Service accounts → Generate new private key
# بدونها تعمل التنبيهات داخل اللوحة والتطبيق، ولا يصل إشعار للهاتف.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
# المفتاح في سطر واحد بـ \n بدل الأسطر
FCM_PRIVATE_KEY=""

# بريد فريق المنصة لتنبيهات الطلبات والإيصالات وطلبات التصميم (يُضاف إلى «notify.emails» في إعدادات المنصة)
TEAM_NOTIFY_EMAIL=""
